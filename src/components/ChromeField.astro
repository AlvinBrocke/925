---
/**
 * The floating chrome objects.
 *
 * Pure markup over chrome.css — no JavaScript, nothing to hydrate. One accent
 * object per section, deliberately: an earlier pass placed 25 of these and the
 * page read as noise. Four survive, chosen because they behave like real metal
 * (the sphere and the conic ring) or because they frame rather than compete
 * (the hero's slow wire orbit around the clock).
 */
interface Props {
  field: 'hero' | 'log' | 'cta' | 'footer';
  class?: string;
}
const { field, class: className } = Astro.props;

/** `spin` rotates an inner child so the float and the rotation compose. */
type Obj = { cls: string; style: string; spin?: string };

const fields: Record<Props['field'], Obj[]> = {
  hero: [
    { cls: 'cx-wire', style: 'top:50%;left:50%;width:660px;height:660px;margin:-330px 0 0 -330px;opacity:.34;animation:spinSlow 90s linear infinite' },
  ],
  log: [
    { cls: 'cx-sphere', style: 'top:14px;right:5%;width:108px;height:108px;opacity:.45;z-index:0;animation:floatA 12s ease-in-out infinite' },
  ],
  cta: [
    { cls: 'cx-ring', style: 'bottom:16px;right:16px;width:clamp(66px,8vw,116px);height:clamp(66px,8vw,116px);opacity:.5;z-index:0;animation:floatC 17s ease-in-out infinite', spin: 'spinRev 30s linear infinite' },
  ],
  footer: [
    { cls: 'cx-sphere', style: 'top:50%;right:24%;width:48px;height:48px;margin-top:-24px;opacity:.35;z-index:0;animation:floatB 11s ease-in-out infinite' },
  ],
};

const objects = fields[field];
---
{objects.map((o) => (
  o.spin
    ? <div class:list={['cx', className]} style={o.style} aria-hidden="true">
        <div class={o.cls} style={`animation:${o.spin}`}></div>
      </div>
    : <div class:list={['cx', o.cls, className]} style={o.style} aria-hidden="true"></div>
))}
