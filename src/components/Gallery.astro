---
import { Image } from 'astro:assets';
import { galleryPhotos, galleryCredit } from '../data/gallery';

/**
 * The floor — a full-bleed, continuously scrolling strip of frames from the
 * first shift.
 *
 * Zero JavaScript, by design. The README is explicit that only Countdown and
 * RsvpForm ship JS, so this is a CSS marquee: the same eight photos are
 * rendered twice and the track is translated by exactly -50%, which lands the
 * duplicate set precisely where the original started. At that instant the
 * animation restarts from 0 and the two frames are pixel-identical, so there is
 * no seam.
 *
 * The -50% only works if the two halves are byte-for-byte the same width, which
 * is why the spacing between cards is a `margin-right` on every card rather
 * than `gap` on the track. `gap` puts 15 gaps between 16 cards, so half the
 * track is one gap short of one set and the loop drifts by half a gap each
 * cycle. A trailing margin gives every card the same outer width, so half the
 * track is exactly eight of them.
 *
 * The duplicate set is `aria-hidden` — a screen reader should hear eight
 * photographs, not sixteen.
 */

/** Two passes over the same array. `duplicate` drives aria-hidden, nothing else:
 *  the markup must otherwise be identical or the halves would not match. */
const passes = [{ duplicate: false }, { duplicate: true }];
---

<section class="gallery" aria-labelledby="gallery-heading">
  <div class="head wrap">
    <p class="eyebrow" data-reveal>Quarterly Review</p>
    <h2 id="gallery-heading" data-reveal style="--reveal-i:1">
      The&nbsp;<span class="accent">Floor</span>
    </h2>
  </div>

  <!-- Full bleed: the strip is the section's full width with no gutter, so
       cards run off both edges. `overflow:hidden` clips them here rather than
       letting the track's width reach the document and force a horizontal
       scrollbar. -->
  <div class="strip" data-reveal style="--reveal-i:2">
    <div class="track">
      {passes.map((pass) => (
        <ul class="set" aria-hidden={pass.duplicate ? 'true' : undefined}>
          {galleryPhotos.map((photo) => (
            <li class="shot">
              {/* Lazy on both halves. The strip is well below the fold and a
                  large share of the audience is on mobile data in Accra, so
                  nothing here should compete with first paint. The duplicate
                  set costs no extra bytes — identical srcset URLs, served from
                  cache the moment it scrolls in.

                  decoding="sync" is deliberate. The default async decode lets
                  the browser present a frame with the image still missing, and
                  on a track that never stops moving it takes that option often
                  — cards slide past as empty rectangles for seconds after they
                  have finished downloading. Sync decoding costs a few ms of
                  main thread per card at 640px and removes the blanks. */}
              <Image
                src={photo.image}
                alt={pass.duplicate ? '' : photo.alt}
                width={720}
                height={960}
                widths={[480, 720, 960]}
                sizes="(max-width: 640px) 335px, 440px"
                quality={68}
                loading="lazy"
                decoding="sync"
                class="shot-img"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
    <div class="fade fade-l" aria-hidden="true"></div>
    <div class="fade fade-r" aria-hidden="true"></div>
  </div>

  <p class="credit wrap" data-reveal>
    <span>{galleryCredit.shift}</span>
    <span aria-hidden="true">/</span>
    <span>Photography {galleryCredit.photographer}</span>
    <span aria-hidden="true">/</span>
    <span>Venue {galleryCredit.venue}</span>
  </p>
</section>

<style>
  .gallery {
    position: relative; padding: 70px 0;
    background-color: var(--near-black);
    background-image: var(--noise-image);
    background-repeat: repeat;
    background-size: var(--noise-size) var(--noise-size);
  }
  .head { padding: 0 40px; margin-bottom: 30px; }
  .eyebrow {
    font-family: var(--font-mono); font-size: 11px; color: var(--teal);
    letter-spacing: var(--tracking-wide); text-transform: uppercase; margin-bottom: 8px;
  }
  h2 {
    font-family: var(--font-display); font-size: var(--text-xl);
    text-transform: uppercase; letter-spacing: var(--tracking-wide);
  }
  .accent { color: var(--teal); }

  /* `--u` is a scalar length every card dimension is expressed in, so the whole
     strip shrinks proportionally on small screens without a second set of
     hand-tuned sizes — and, more importantly, without changing the ratio the
     -50% translate depends on. */
  .strip {
    --u: 1px;
    --gap: calc(28 * var(--u));
    position: relative;
    overflow: hidden;
    padding: calc(30 * var(--u)) 0;
  }

  .track {
    display: flex;
    width: max-content;
    animation: floorMarquee 58s linear infinite;
    will-change: transform;
  }
  /* One full set is exactly half the track, so the loop point is invisible. */
  @keyframes floorMarquee {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }
  /* Hover holds it still to read a frame; focus-within does the same for
     anyone arriving by keyboard. */
  .strip:hover .track,
  .strip:focus-within .track { animation-play-state: paused; }

  .set { display: flex; align-items: center; margin: 0; padding: 0; list-style: none; }

  .shot {
    flex: none;
    /* Trailing margin, not gap — see the component comment. Every card has the
       same outer width, so half the track is exactly eight cards. */
    margin-right: var(--gap);
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-raised);
    box-shadow: var(--shadow-card), var(--shadow-hairline);
    transform: rotate(var(--rot));
  }
  .shot-img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Scattered, not gridded: each card gets its own tilt and its own size. The
     cycle is eight, matching the set length, so a card and its duplicate are
     always identical — a different tilt across the loop point would show up as
     a jump. */
  .shot:nth-child(1) { --w: 400; --h: 530; --rot: -3.2deg; }
  .shot:nth-child(2) { --w: 345; --h: 460; --rot:  2.4deg; }
  .shot:nth-child(3) { --w: 435; --h: 570; --rot: -1.4deg; }
  .shot:nth-child(4) { --w: 370; --h: 495; --rot:  4.1deg; }
  .shot:nth-child(5) { --w: 415; --h: 545; --rot: -4.6deg; }
  .shot:nth-child(6) { --w: 360; --h: 475; --rot:  1.8deg; }
  .shot:nth-child(7) { --w: 430; --h: 555; --rot: -2.2deg; }
  .shot:nth-child(8) { --w: 385; --h: 510; --rot:  3.6deg; }

  /* Short washes so the cards dissolve into the page instead of being sliced
     off by the viewport edge. */
  .fade {
    position: absolute; top: 0; bottom: 0; width: 130px;
    pointer-events: none;
  }
  .fade-l { left: 0;  background: linear-gradient(90deg, var(--black), transparent); }
  .fade-r { right: 0; background: linear-gradient(270deg, var(--black), transparent); }

  .credit {
    padding: 26px 40px 0;
    display: flex; flex-wrap: wrap; gap: 0 var(--space-3);
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider); text-transform: uppercase;
    color: var(--text-muted);
  }
  .credit span[aria-hidden] { color: var(--chrome-700); opacity: .6; }

  @media (max-width: 767px) {
    .gallery { padding: 48px 0; }
    .head { padding: 0 20px; }
    .credit { padding: 22px 20px 0; }
    .strip { --u: 0.76px; }
    .fade { width: 64px; }
  }

  /* The global reduced-motion rule collapses animations to ~0s, which would
     leave the track parked at translateX(0) — first card flush to the left
     edge, reading as a strip that failed to start. Stopping the animation
     outright and offsetting the track instead keeps a card bleeding off each
     side, so the static state looks like a deliberate slice of a longer strip. */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      transform: translate3d(calc(-64 * var(--u)), 0, 0);
    }
  }
</style>
