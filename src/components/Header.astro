---
import { Image } from 'astro:assets';
import logo from '../assets/logo-horizontal-chrome.png';
---
<header class="nav">
  <a href="/" aria-label="925 home">
    <Image src={logo} alt="925" height={36} densities={[1, 2]} />
  </a>
  <nav class="links" aria-label="Primary">
    <a href="#on-shift">On Shift</a>
    <a href="#shift-log">Past Shifts</a>
    <a href="#manifesto">Manifesto</a>
  </nav>
  <button class="btn-sm" data-clock-in>Clock In</button>
</header>

<style>
  .nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 40px; border-bottom: 1px solid var(--border-hairline);
    position: sticky; top: 0; background: #000000e6;
    backdrop-filter: blur(6px); z-index: 20; gap: var(--space-5);
  }
  .nav :global(img) { height: 36px; width: auto; object-fit: contain; }
  .links {
    display: flex; gap: 28px; font-family: var(--font-display); font-size: 13px;
    letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--chrome-300);
  }
  .links a { text-decoration: none; transition: color var(--duration-fast) var(--ease-standard); }
  .links a:hover { color: var(--teal); }
  .btn-sm {
    font-family: var(--font-display); font-weight: 700; font-size: 13px;
    letter-spacing: var(--tracking-wider); text-transform: uppercase;
    padding: 8px 16px; border: 1px solid transparent; border-radius: var(--radius-sm);
    background: var(--accent); color: var(--accent-contrast);
    box-shadow: var(--shadow-glow-sm); cursor: pointer;
    transition: all var(--duration-base) var(--ease-standard);
  }
  .btn-sm:hover { background: var(--accent-hover); }
  @media (max-width: 767px) { .nav { padding: 16px 20px; } .links { display: none; } }
</style>
