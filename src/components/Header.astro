---
import { Image } from 'astro:assets';
import logo from '../assets/logo-925-lockup.png';
import { PASSA_CHECKOUT_URL } from '../data/tickets';
---
<header class="nav">
  <a href="/" aria-label="925 home">
    <Image src={logo} alt="925 — Second Shift" height={36} densities={[1, 2]} />
  </a>
  <nav class="links" aria-label="Primary">
    <a href="#on-shift">On Shift</a>
    <a href="#tickets">Tickets</a>
    <a href="#manifesto">Manifesto</a>
  </nav>
  <!-- Both actions ride along in the sticky bar: buying is the one that pays
       for the night, clocking in is the one that gets you the address. The
       ghost button keeps the pair from reading as two primaries. -->
  <div class="actions">
    <button class="btn-sm btn-ghost" data-clock-in>Clock In</button>
    <a class="btn-sm" href={PASSA_CHECKOUT_URL} target="_blank" rel="noopener noreferrer">Tickets</a>
  </div>
</header>

<style>
  .nav {
    display: flex; align-items: center; justify-content: space-between;
    padding: 20px 40px; border-bottom: 1px solid var(--border-hairline);
    position: sticky; top: 0; background: #000000e6;
    backdrop-filter: blur(6px); z-index: 20; gap: var(--space-5);
  }
  .nav :global(img) { height: 36px; width: auto; object-fit: contain; }
  .links {
    display: flex; gap: 28px; font-family: var(--font-display); font-size: 13px;
    letter-spacing: var(--tracking-wider); text-transform: uppercase; color: var(--chrome-300);
  }
  .links a { text-decoration: none; transition: color var(--duration-fast) var(--ease-standard); }
  .links a:hover { color: var(--teal); }
  .actions { display: flex; align-items: center; gap: 10px; }
  .btn-sm {
    font-family: var(--font-display); font-weight: 700; font-size: 13px;
    letter-spacing: var(--tracking-wider); text-transform: uppercase;
    padding: 8px 16px; border: 1px solid transparent; border-radius: var(--radius-sm);
    background: var(--accent); color: var(--accent-contrast);
    box-shadow: var(--shadow-glow-sm); cursor: pointer;
    transition: all var(--duration-base) var(--ease-standard);
  }
  .btn-sm { text-decoration: none; display: inline-block; }
  .btn-sm:hover { background: var(--accent-hover); }
  .btn-ghost {
    background: transparent; color: var(--chrome-100);
    border-color: var(--border-hairline); box-shadow: none;
  }
  .btn-ghost:hover { background: transparent; border-color: var(--teal); color: var(--teal); }
  /* At the very top the bar is barely there — a blur over the hero clock with
     no fill and no rule under it. It gains its background and its hairline
     over the first 160px, so the header arrives as you leave the hero instead
     of sitting on top of it from the start.

     Only background-color and border-color move. The blur is held constant
     (animating backdrop-filter re-rasterises the whole strip every frame) and
     nothing here touches height or padding, because the bar is in flow and
     resizing it mid-scroll would shove the page under the reader's cursor. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .nav {
        animation: navSettle linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 160px;
      }
    }
  }
  @keyframes navSettle {
    from { background: #0000; border-bottom-color: #0000; }
    to   { background: #000000e6; border-bottom-color: var(--border-hairline); }
  }

  @media (max-width: 767px) {
    .nav { padding: 16px 20px; gap: var(--space-3); }
    .links { display: none; }
    .btn-sm { padding: 8px 12px; }
  }
</style>
